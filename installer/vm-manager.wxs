<?xml version="1.0" encoding="utf-8"?>
<!--
  Installateur Windows (WiX Toolset v5), construit par .github/workflows/build.yml :
    wix build installer/vm-manager.wxs -arch x64 -d Version=… -d BinDir=… -d RootDir=… -d AssetsDir=…
  Installe VM Manager dans « Program Files\VM Manager » avec un raccourci dans le menu Démarrer.
  L'inventaire est alors enregistré dans %APPDATA%\VM Manager (dossier d'installation non modifiable).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="VM Manager"
      Manufacturer="Neoofix"
      Version="$(Version)"
      UpgradeCode="46DB7691-083A-4EB3-BE01-6E9CC16C3A0A"
      Language="1036"
      Codepage="1252"
      Scope="perMachine"
      Compressed="yes">

    <!-- Même UpgradeCode à chaque version : une nouvelle installation remplace l'ancienne -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Une version plus récente de VM Manager est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(AssetsDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Neoofix/VM-manager" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VM Manager" />
    </StandardDirectory>

    <Feature Id="Main" Title="VM Manager">
      <Component Directory="INSTALLFOLDER">
        <File Id="VmManagerExe" Source="$(BinDir)\vm-manager.exe" KeyPath="yes">
          <Shortcut
              Id="StartMenuShortcut"
              Name="VM Manager"
              Description="Inventaire de machines virtuelles"
              Directory="ProgramMenuFolder"
              WorkingDirectory="INSTALLFOLDER"
              Icon="AppIcon.ico"
              Advertise="yes" />
        </File>
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="Readme" Source="$(RootDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="License" Source="$(RootDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
